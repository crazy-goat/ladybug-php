# Keep the Composer dist to what a consumer actually needs: the PHP sources and the
# extension's build inputs. Tests, tooling configs and CI stay in the git repository.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.php-cs-fixer.dist.php export-ignore
/phpstan.neon       export-ignore
/phpunit.xml        export-ignore
/rector.php         export-ignore
/tests              export-ignore
/examples           export-ignore
/ext/tests          export-ignore

# Line endings: the .phpt format is whitespace-sensitive.
*.phpt              -text
*.c                 text eol=lf
*.h                 text eol=lf
*.m4                text eol=lf
*.map               text eol=lf
*.php               text eol=lf
